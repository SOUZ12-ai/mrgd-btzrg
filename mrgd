<!DOCTYPE html>
<html lang="mn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Болзооны урилга 💖</title>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 15px;
      box-sizing: border-box;
    }

    .card {
      background: rgba(255, 255, 255, 0.95);
      padding: 30px;
      border-radius: 24px;
      box-shadow: 0 15px 35px rgba(255, 77, 109, 0.2);
      text-align: center;
      max-width: 420px;
      width: 100%;
      transition: all 0.3s ease;
    }

    .hidden {
      display: none !important;
    }

    img {
      width: 180px;
      height: 180px;
      object-fit: cover;
      border-radius: 16px;
      margin-bottom: 20px;
      box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    }

    h1 {
      color: #ff4d6d;
      font-size: 22px;
      margin-bottom: 20px;
      line-height: 1.4;
    }

    .btn-container {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 15px;
      margin-top: 20px;
      min-height: 100px;
    }

    button {
      padding: 12px 24px;
      font-size: 16px;
      font-weight: bold;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.2s ease;
      outline: none;
    }

    #yes-btn {
      background-color: #ff4d6d;
      color: white;
      box-shadow: 0 4px 15px rgba(255, 77, 109, 0.4);
      z-index: 10;
    }

    #yes-btn:hover {
      background-color: #ff2a55;
      transform: scale(1.05);
    }

    #no-btn {
      background-color: #6c757d;
      color: white;
    }

    .fixed-info {
      background: #fff0f3;
      border: 2px dashed #ff4d6d;
      border-radius: 12px;
      padding: 12px;
      font-size: 18px;
      font-weight: bold;
      color: #ff4d6d;
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 20px;
      text-align: left;
    }

    label {
      display: block;
      font-size: 14px;
      color: #495057;
      margin-bottom: 8px;
      font-weight: bold;
    }

    input[type="time"] {
      width: 100%;
      padding: 12px;
      border: 2px solid #ffccd5;
      border-radius: 12px;
      box-sizing: border-box;
      font-size: 16px;
      outline: none;
    }

    .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      background: #fff5f7;
      padding: 15px;
      border-radius: 12px;
      max-height: 200px;
      overflow-y: auto;
      border: 1px solid #ffe6eb;
    }

    .checkbox-item {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      font-size: 15px;
      color: #333;
    }

    .checkbox-item input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: #ff4d6d;
      cursor: pointer;
    }

    #submit-btn {
      width: 100%;
      background-color: #ff4d6d;
      color: white;
      padding: 14px;
      font-size: 18px;
      box-shadow: 0 4px 15px rgba(255, 77, 109, 0.4);
      margin-top: 10px;
    }

    #submit-btn:hover {
      background-color: #ff2a55;
    }

    .status-msg {
      font-size: 14px;
      color: #888;
      margin-top: 10px;
    }

    .summary-box {
      background: #fff0f3;
      padding: 15px;
      border-radius: 12px;
      text-align: left;
      margin: 15px 0;
      font-size: 15px;
      color: #333;
      line-height: 1.6;
    }
  </style>
</head>
<body>

  <!-- 1-Р АЛХАМ -->
  <div id="question-card" class="card">
    <img src="https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExM3h2Z2hhNHI0dGNidW14dW4xbzhxOWFqMmpmMm85bjlzbG43OXB6dyZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/Lml2iBuh1MStYkH2bZ/giphy.gif" alt="Cute GIF">
    <h1>Намтай болзоонд явах уу? 🥺💖</h1>
    
    <div class="btn-container">
      <button id="yes-btn">Тийм! 💕</button>
      <button id="no-btn">Үгүй 😢</button>
    </div>
  </div>

  <!-- 2-Р АЛХАМ -->
  <div id="details-card" class="card hidden">
    <h1>Болзооны цаг ба хувцаслалтаа тохирцгооё! 🥳</h1>
    
    <div class="fixed-info">
      📅 Өдөр: 2026.09.23
    </div>

    <form id="date-form">
      <div class="form-group">
        <label for="time">⏰ Хэдэн цагт уулзах вэ?</label>
        <input type="time" id="time" required value="18:00">
      </div>

      <div class="form-group">
        <label>👗 Ямар хувцастай очих вэ? (Сонголтоо хийнэ үү):</label>
        <div class="checkbox-group">
          <label class="checkbox-item"><input type="checkbox" name="outfit" value="Цагаан подволк"> Цагаан подволк</label>
          <label class="checkbox-item"><input type="checkbox" name="outfit" value="Цагаан hoodie"> Цагаан hoodie</label>
          <label class="checkbox-item"><input type="checkbox" name="outfit" value="Хар малгай (надаа 2 байгаа)"> Хар малгай (надаа 2 байгаа)</label>
          <label class="checkbox-item"><input type="checkbox" name="outfit" value="Хар цамц"> Хар цамц</label>
          <label class="checkbox-item"><input type="checkbox" name="outfit" value="Хар өмд"> Хар өмд</label>
          <label class="checkbox-item"><input type="checkbox" name="outfit" value="Jeans"> Jeans</label>
          <label class="checkbox-item"><input type="checkbox" name="outfit" value="Өөрөө мэдээд өмсчих өөр"> Өөрөө мэдээд өмсчих өөр</label>
        </div>
      </div>

      <button type="submit" id="submit-btn">Тохирлоо! ✨</button>
      <div id="status-msg" class="status-msg"></div>
    </form>
  </div>

  <!-- 3-Р АЛХАМ -->
  <div id="final-card" class="card hidden">
    <img src="https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExOHp1eXU2ZjUxcXRzc3Nqdmp2ZnR1Znd3ZW4xeWV6aGd3cGFpODV1eiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/26hpW3f86zIu98BBS/giphy.gif" alt="Happy GIF">
    <h1>Амжилттай баталгаажлаа! 🎉</h1>
    <p style="color: #666; font-size: 14px;">Мэдээлэл Телеграм руу амжилттай илгээгдлээ!</p>
    
    <div class="summary-box" id="summary-text"></div>
    <p style="color: #ff4d6d; font-weight: bold; font-size: 18px;">Би чамайг тэсэн ядан хүлээж байя! 🥰</p>
  </div>

  <script>
    const TELEGRAM_BOT_TOKEN = "8859580147:AAGUlvAJwDeaWMgwZAOMOnpZgUv85PY9E6o";
    const TELEGRAM_CHAT_ID = "8859580147";

    let yesSize = 16;
    let yesPaddingV = 12;
    let yesPaddingH = 24;
    let noSize = 16;

    const yesBtn = document.getElementById('yes-btn');
    const noBtn = document.getElementById('no-btn');

    const questionCard = document.getElementById('question-card');
    const detailsCard = document.getElementById('details-card');
    const finalCard = document.getElementById('final-card');
    const dateForm = document.getElementById('date-form');
    const summaryText = document.getElementById('summary-text');
    const statusMsg = document.getElementById('status-msg');

    noBtn.addEventListener('click', () => {
      yesSize += 8;
      yesPaddingV += 4;
      yesPaddingH += 8;
      
      yesBtn.style.fontSize = `${yesSize}px`;
      yesBtn.style.padding = `${yesPaddingV}px ${yesPaddingH}px`;

      if (noSize > 8) {
        noSize -= 2;
        noBtn.style.fontSize = `${noSize}px`;
        noBtn.style.padding = `${Math.max(4, noSize - 8)}px ${Math.max(8, noSize - 4)}px`;
      }
    });

    yesBtn.addEventListener('click', () => {
      questionCard.classList.add('hidden');
      detailsCard.classList.remove('hidden');
    });

    dateForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const selectedTime = document.getElementById('time').value;
      const checkedOutfits = Array.from(document.querySelectorAll('input[name="outfit"]:checked'))
                                  .map(cb => cb.value);

      const outfitText = checkedOutfits.length > 0 ? checkedOutfits.join(', ') : 'Сонгоогүй';

      statusMsg.innerText = "Мэдээллийг илгээж байна...";

      const telegramMessage = `💖 *БОЛЗООРХОХ ХҮСЭЛТ БАТАЛГААЖЛАА!* 💖\n\n` +
                              `📅 *Өдөр:* 2026.09.23\n` +
                              `⏰ *Цаг:* ${selectedTime}\n` +
                              `👗 *Сонгосон хувцас:* ${outfitText}`;

      try {
        await fetch(`https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            chat_id: TELEGRAM_CHAT_ID,
            text: telegramMessage,
            parse_mode: 'Markdown'
          })
        });

        summaryText.innerHTML = `
          <strong>📅 Өдөр:</strong> 2026.09.23<br>
          <strong>⏰ Цаг:</strong> ${selectedTime}<br>
          <strong>👗 Сонгосон хувцаслалт:</strong> ${outfitText}
        `;

        detailsCard.classList.add('hidden');
        finalCard.classList.remove('hidden');

        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 }
        });

      } catch (err) {
        alert("Алдаа гарлаа. Та Телеграм дээрээ бот руугаа /start гэж бичсэн эсэхээ шалгаарай!");
        statusMsg.innerText = "Илгээхэд алдаа гарлаа.";
      }
    });
  </script>
</body>
</html>
